# ── Kavach Environment Variables ──
# Copy this to .env and fill in your values

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Trusted contacts (comma-separated phone numbers)
TRUSTED_CONTACTS=+91XXXXXXXXXX,+91XXXXXXXXXX

# 112 API (mock for MVP)
EMERGENCY_API_URL=https://mock-112-api.example.com/alert
EMERGENCY_API_KEY=mock_key

# AWS S3 Evidence Vault
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=kavach-evidence-vault
AWS_REGION=ap-south-1

# App
SECRET_KEY=change_this_to_a_random_secret_key_32chars
DEBUG=true
PORT=8000

# QML Model
QML_MODEL_PATH=quantum/model/vqc_weights.npy
QML_THREAT_THRESHOLD_LOW=0.3
QML_THREAT_THRESHOLD_MEDIUM=0.6
QML_THREAT_THRESHOLD_HIGH=0.85

# ESP32
ESP32_DEVICE_ID=kavach-device-001
ESP32_WEBSOCKET_PORT=8001
